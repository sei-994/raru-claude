{
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    },
    {
      "src": "raru/package.json",
      "use": "@vercel/next"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/raru/api/$1"
    },
    {
      "src": "/raru/(.*)",
      "dest": "/raru/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}