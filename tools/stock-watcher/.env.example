# ---------------------------------------------------------------------------
# このファイルを .env にコピーして編集してください
#   cp .env.example .env
# 実際の環境変数のほうが .env より優先されます。
# .env は .gitignore 済みなので、Webhook URL を書いてもコミットされません。
# ---------------------------------------------------------------------------

# Discord Webhook URL（必須）
# チャンネルの歯車 → 連携サービス → ウェブフック → 新しいウェブフック
DISCORD_WEBHOOK_URL=

# 監視する品番（必須・カンマ区切り）
# iPhone Duo 256GB SIMフリー（7.6インチ折りたたみ / 2026-10-23 発売 / eSIM専用）。
# 256GB は2色のみ。いずれも小売店の商品ページから取得した値です。
#   MK244J/A スターホワイト  … ケーズデンキ・ヤマダの商品ページで一致
#   MK254J/A ナイトスカイ    … ヨドバシの商品ページ
# --doctor の [2/4] で実在を確認してください。✗ が出たら --find-parts で調べ直す:
#   APPLE_BUY_PAGE="https://www.apple.com/jp/shop/buy-iphone/iphone-duo" \
#     node apple-stock.js --find-parts 256
# 512GB / 2TB も監視するなら、同じ方法で品番を調べて足してください。
# 表示名は prices.json の labels で設定します。
APPLE_PARTS=MK244J/A,MK254J/A

# 問い合わせる地点（必須・カンマ区切り）
# 2026-09-18 の実測では、150-0041（渋谷）の1地点だけで
# 渋谷/表参道/新宿/丸の内/銀座/川崎 の6店舗すべてが返ってきた。
# 遠方の店舗を足したい場合のみ地点を増やすこと（リクエスト数が地点数だけ増える）。
APPLE_LOCATION=150-0041

# 監視する店舗（店舗名の部分一致。カンマ区切りのOR。空にすると全店舗が対象）
# 表参道は渋谷区・渋谷駅から徒歩圏なので入れてある。要らなければ消す。
# 丸の内/銀座も足せる（--doctor の [1/4] に返ってきた店舗一覧が出る）。
STORE_FILTER=川崎,渋谷,新宿,表参道

# 通知の先頭に付ける文字列。スマホを鳴らしたいなら設定する。
# 自分だけに飛ばすなら <@あなたのユーザーID>、全員なら @everyone
MENTION=

# 監視間隔（秒）。
# 【重要】2026-09-24 に、60秒間隔で約6日間回し続けたところ Apple 側に
# HTTP 541 で弾かれました（1日あたり約8,600リクエスト）。
# 300秒（5分）以上を推奨します。発売直後の数時間だけ短くして、
# 落ち着いたら戻す運用が安全です。60秒未満にはしないでください。
# 地点を複数指定している場合、1サイクルで地点数だけリクエストが飛びます。
INTERVAL_SEC=300

# 在庫ありが続く間の再通知間隔（分）。0 で再通知なし。
REPEAT_MIN=30

# オンライン配送の可否も監視するなら 1
INCLUDE_DELIVERY=0

# 買取価格の取得元（node apple-stock.js --fetch-prices）。
# 非公式の集計サイトなので、通知には「参考値」と明記される。
# 表は 機種×容量 単位で、色の区別はない。
# 【注意】下のURLは iPhone 18 の買取価格ページです。iPhone Duo の価格は載っていません。
# Duo の買取価格を取るには、該当ページを探して差し替えてください。確認方法:
#   TARGET_URL="<候補のURL>" node check.js --scan "Duo"
BUYBACK_URL=https://is-checker.com/i18_stock_4.html?411

# --watch 中に買取価格を取り直す間隔（分）。0 で自動更新しない。
PRICE_REFRESH_MIN=60
