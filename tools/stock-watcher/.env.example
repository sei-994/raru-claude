# ---------------------------------------------------------------------------
# このファイルを .env にコピーして編集してください
#   cp .env.example .env
# 実際の環境変数のほうが .env より優先されます。
# .env は .gitignore 済みなので、Webhook URL を書いてもコミットされません。
# ---------------------------------------------------------------------------

# Discord Webhook URL（必須）
# チャンネルの歯車 → 連携サービス → ウェブフック → 新しいウェブフック
DISCORD_WEBHOOK_URL=

# 監視する品番（必須・カンマ区切り）
# 下は iPhone 18 Pro Max 256GB SIMフリーの調査結果（2026-09-18時点・要検証）
#   MJX54J/A ブラック / MJX64J/A シルバー / MJX74J/A バーガンディ / MJX84J/A グレイシャー
# 色にこだわりがないなら全部並べる。1色に絞るなら不要な行を消す。
# 正しいかどうかは --doctor が判定します。
APPLE_PARTS=MJX54J/A,MJX64J/A,MJX74J/A,MJX84J/A

# 問い合わせる地点（必須・カンマ区切り）
# Apple は指定地点の近隣店舗しか返さないため、離れた店舗は地点を分けて指定する。
# 郵便番号は目安。--doctor が「実際にどの店舗が返ったか」と
# 「地点を減らせるか」を教えてくれるので、それを見て調整すること。
APPLE_LOCATION=150-0041,160-0022,212-0013

# 監視する店舗（カンマ区切りのOR。空にすると返ってきた全店舗が対象）
STORE_FILTER=川崎,渋谷,新宿

# 通知の先頭に付ける文字列。スマホを鳴らしたいなら設定する。
# 自分だけに飛ばすなら <@あなたのユーザーID>、全員なら @everyone
MENTION=

# 監視間隔（秒）。30未満にしないこと。地点を複数指定している場合、
# 1サイクルで地点数ぶんのリクエストが飛ぶ点に注意。
INTERVAL_SEC=60

# 在庫ありが続く間の再通知間隔（分）。0 で再通知なし。
REPEAT_MIN=30

# オンライン配送の可否も監視するなら 1
INCLUDE_DELIVERY=0
