# ---------------------------------------------------------------------------
# このファイルを .env にコピーして編集してください
#   cp .env.example .env
# 実際の環境変数のほうが .env より優先されます。
# .env は .gitignore 済みなので、Webhook URL を書いてもコミットされません。
# ---------------------------------------------------------------------------

# Discord Webhook URL（必須）
# チャンネルの歯車 → 連携サービス → ウェブフック → 新しいウェブフック
DISCORD_WEBHOOK_URL=

# 監視する品番（必須・カンマ区切り）
# iPhone 18 Pro Max SIMフリー。
#
# 256GB — 4つとも 2026-09-18 に --doctor で実在確認済み
#   MJX54J/A ブラック / MJX64J/A シルバー / MJX74J/A バーガンディ / MJX84J/A グレイシャー
#
# 512GB — MJXC4J/A(バーガンディ) のみ小売店の商品ページで確認。
#         残り3つは256GBの採番規則からの【推測】。誤っていれば --doctor が ✗ を出すので、
#         その行を消せばよい。正しい品番は --find-parts でも調べられる。
#   MJXA4J/A ブラック / MJXB4J/A シルバー / MJXC4J/A バーガンディ / MJXD4J/A グレイシャー
#
# 表示名は prices.json の labels で設定する（通知に「512GB ブラック」と出る）。
APPLE_PARTS=MJX54J/A,MJX64J/A,MJX74J/A,MJX84J/A,MJXA4J/A,MJXB4J/A,MJXC4J/A,MJXD4J/A

# 問い合わせる地点（必須・カンマ区切り）
# 2026-09-18 の実測では、150-0041（渋谷）の1地点だけで
# 渋谷/表参道/新宿/丸の内/銀座/川崎 の6店舗すべてが返ってきた。
# 遠方の店舗を足したい場合のみ地点を増やすこと（リクエスト数が地点数だけ増える）。
APPLE_LOCATION=150-0041

# 監視する店舗（店舗名の部分一致。カンマ区切りのOR。空にすると全店舗が対象）
# 表参道は渋谷区・渋谷駅から徒歩圏なので入れてある。要らなければ消す。
# 丸の内/銀座も足せる（--doctor の [1/4] に返ってきた店舗一覧が出る）。
STORE_FILTER=川崎,渋谷,新宿,表参道

# 通知の先頭に付ける文字列。スマホを鳴らしたいなら設定する。
# 自分だけに飛ばすなら <@あなたのユーザーID>、全員なら @everyone
MENTION=

# 監視間隔（秒）。30未満にしないこと。地点を複数指定している場合、
# 1サイクルで地点数ぶんのリクエストが飛ぶ点に注意。
INTERVAL_SEC=60

# 在庫ありが続く間の再通知間隔（分）。0 で再通知なし。
REPEAT_MIN=30

# オンライン配送の可否も監視するなら 1
INCLUDE_DELIVERY=0
